{
  "manifestVersion": 2,
  "id": "workspace-explorer",
  "name": "Workspace Explorer",
  "version": "0.2.1",
  "description": "모든 워크스페이스와 원하는 경로를 Finder처럼 탐색하고, 파일을 Orca 탭으로 열어 읽고 수정·삭제합니다.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "explorer",
        "title": "Workspace Explorer",
        "icon": "folder",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "showIgnored",
        "title": "무시된 파일 표시",
        "description": ".gitignore 대상과 node_modules 같은 기본 무시 항목을 트리에 표시합니다.",
        "type": "boolean",
        "default": false
      },
      {
        "key": "maxEntriesPerDir",
        "title": "폴더당 최대 항목 수",
        "description": "한 폴더에서 이 개수를 넘는 항목은 잘라서 보여줍니다.",
        "type": "integer",
        "default": 500,
        "minimum": 50,
        "maximum": 2000
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    }
  ]
}
